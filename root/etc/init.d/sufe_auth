#!/bin/sh /etc/rc.common

USE_PROCD=1
START=70
STOP=10

PROG="/usr/sbin/sufe_auth"

run_instance() {
    local section="$1"
    local enable ifname username password

    config_get_bool enable "$section" enable 1
    [ "$enable" -eq 1 ] || return 0

    config_get ifname "$section" ifname "eth1"
    config_get username "$section" username ""
    config_get password "$section" password ""

    [ -n "$username" ] && [ -n "$password" ] || return 0

    # Only the section name is passed on the command line.  The daemon reads
    # the username/password from UCI itself, so credentials never show up in
    # `ps` output.  The old init script passed -u/-p directly.
    procd_open_instance "sufe_auth_${section}"
    procd_set_param command "$PROG" -n "$section"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    config_load sufe_auth
    local count=0
    count_account() {
        count=$((count + 1))
    }
    config_foreach count_account account

    if [ "$count" -gt 0 ]; then
        config_foreach run_instance account
    else
        # Backward compatibility for the legacy single-section 'config'.
        local enable
        config_get_bool enable config enable 0
        if [ "$enable" -eq 1 ]; then
            run_instance config
        fi
    fi
}

service_triggers() {
    procd_add_reload_trigger "sufe_auth"
}
