#!/bin/sh /etc/rc.common

USE_PROCD=1
START=70
STOP=10

PROG="/usr/sbin/sufe_auth"

run_instance() {
    local section="$1"
    local enable label ifname username password mac switch_mac network

    config_get_bool enable "$section" enable 1
    [ "$enable" -eq 1 ] || return 0

    config_get label "$section" label "$section"
    config_get ifname "$section" ifname "eth1"
    config_get username "$section" username ""
    config_get password "$section" password ""
    config_get mac "$section" mac ""
    config_get switch_mac "$section" switch_mac "58:ae:a8:88:0c:31"
    config_get network "$section" network "wan"

    [ -n "$username" ] && [ -n "$password" ] || return 0

    procd_open_instance "sufe_auth_${section}"
    procd_set_param command "$PROG" -i "$ifname" -u "$username" -p "$password"
    [ -n "$mac" ] && procd_append_param command -m "$mac"
    [ -n "$switch_mac" ] && procd_append_param command -s "$switch_mac"
    [ -n "$network" ] && procd_append_param command -N "$network"
    procd_append_param command -n "$section"
    procd_append_param command -d
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    config_load sufe_auth
    local count=0
    count_account() {
        count=$((count + 1))
    }
    config_foreach count_account account

    if [ "$count" -gt 0 ]; then
        config_foreach run_instance account
    else
        # Backward compatibility for legacy single-section 'config'
        local enable
        config_get_bool enable config enable 0
        if [ "$enable" -eq 1 ]; then
            run_instance config
        fi
    fi
}

service_triggers() {
    procd_add_reload_trigger "sufe_auth"
}
