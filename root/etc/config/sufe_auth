# 上海财经大学校园网认证 - 多线路多账号配置文件
# 每个 account 对应一个物理/ VLAN 网口和一个逻辑 network。
config account 'wan'
	option enable '1'
	option label '主校园网 (WAN1)'
	option ifname 'eth1'
	option network 'wan'
	option username ''
	option password ''
	option mac ''
	option switch_mac '58:ae:a8:88:0c:31'

# 可选调优项（不写则用默认值，通常不需要改）：
